# --- Application ---
APP_NAME=CronApp
APP_URL=https://cron.example.gr
APP_DEBUG=false
# 32 random bytes, base64. Generate with: php bin/keygen.php
APP_KEY=

# --- Database (MariaDB / MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cronapp
DB_USER=cronapp
DB_PASS=

# --- Web Push (VAPID). Generate with: php bin/keygen.php ---
VAPID_SUBJECT=mailto:admin@example.gr
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Platform mailer (invitations). Optional ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=CronApp

# --- Security ---
# Allow jobs to call private/loopback addresses (only for local development!)
ALLOW_PRIVATE_TARGETS=false
# Extra blocked hosts/IPs, comma separated (e.g. the server's own public IP)
BLOCKED_HOSTS=
