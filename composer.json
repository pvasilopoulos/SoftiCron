{
    "name": "cronapp/cronapp",
    "description": "Multi-tenant cron job manager for HTTP calls and webhooks",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "dragonmantank/cron-expression": "^3.4",
        "minishlink/web-push": "^9.0",
        "nikic/fast-route": "^1.3",
        "phpmailer/phpmailer": "^6.9",
        "twig/twig": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
